{
  "name": "varmq-benchmarks",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/dataset", "/dataset/*"]
  },
  "routes": [{ "pattern": "benchmarks.goptics.org", "custom_domain": true }]
}
